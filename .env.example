# ─────────────────────────────────────────────────────────────────────────────
# Copiez ce fichier vers .env puis renseignez les valeurs.
# Les variables sont VALIDÉES au démarrage (src/config/env.validation.ts) :
# l'API refuse de démarrer si un secret est absent ou trop faible.
# ─────────────────────────────────────────────────────────────────────────────

# Environnement : development | production | test
NODE_ENV=development
PORT=3000

# ── Base de données ─────────────────────────────────────────────────────────
# Dev local en pointant vers la base du docker-compose (exposée sur 5434) :
DATABASE_URL="postgresql://yego:yego@localhost:5434/yego?schema=public"
# (Postgres local classique : remplacez 5434 par 5432.)

# ── JWT / sessions ──────────────────────────────────────────────────────────
# OBLIGATOIRE, minimum 32 caractères. Générez :  openssl rand -base64 48
JWT_SECRET="REMPLACEZ_MOI_par_une_valeur_aleatoire_de_48_caracteres_minimum"
# Durée de l'access token (court). Le client le renouvelle via /auth/refresh.
JWT_EXPIRES_IN="15m"
# Durée de vie du refresh token, en jours.
REFRESH_TOKEN_EXPIRES_DAYS=30
# Délai de paiement d'une réservation avant libération automatique des places (min).
RESERVATION_PAIEMENT_TTL_MINUTES=30

# ── Webhook paiement ────────────────────────────────────────────────────────
# OBLIGATOIRE, minimum 16 caractères, DISTINCT de JWT_SECRET.
# Attendu dans l'en-tête 'x-webhook-secret' des appels de confirmation.
PAYMENT_WEBHOOK_SECRET="REMPLACEZ_MOI_secret_webhook_distinct"
# Mode simulation : expose POST /paiements/reservation/:id/simuler pour marquer
# un paiement « payé » / « echoue » sans transaction réelle (dev, tests d'app).
# NE JAMAIS mettre à true sur une vraie production.
PAYMENT_SIMULATION=false

# ── Signature des tickets (validation QR hors-ligne) ────────────────────────
# Clé privée Ed25519 au format PEM PKCS#8. Génération :
#   openssl genpkey -algorithm ed25519 -out ticket_ed25519.pem
# Coller le contenu sur une ligne avec des \n littéraux, ou en multi-ligne si
# votre loader .env le supporte. Absente = paire éphémère régénérée à chaque
# démarrage (dev uniquement).
TICKET_SIGNING_PRIVATE_KEY=""

# ── Documents uploadés ──────────────────────────────────────────────────────
# Dossier de stockage des pièces d'inscription compagnie. En Docker : volume
# dédié (voir docker-compose.yml) ; en dev local, dossier relatif ignoré par git.
UPLOADS_DIR="./uploads"

# ── CORS ────────────────────────────────────────────────────────────────────
# Liste d'origines séparées par des virgules. En production, '*' est INTERDIT.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# ── Divers ──────────────────────────────────────────────────────────────────
LOG_LEVEL=log
# Exposer /api/v1/docs même en production (déconseillé) :
SWAGGER_ENABLED=false

# ── Notifications push (Firebase Cloud Messaging) — optionnel ───────────────
# Sans ces valeurs : les notifications restent consultables dans le fil in-app
# (GET /notifications) mais ne partent pas en push. Valeurs issues du fichier
# de compte de service Firebase ; garder les \n littéraux dans la clé privée.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# ── Opérateurs Mobile Money (intégration à finaliser) ───────────────────────
ORANGE_MONEY_API_KEY=""
MTN_MONEY_API_KEY=""
MOOV_MONEY_API_KEY=""
WAVE_API_KEY=""

# ═════════════════════════════════════════════════════════════════════════════
# Variables utilisées UNIQUEMENT par docker-compose.yml
# ═════════════════════════════════════════════════════════════════════════════
POSTGRES_USER=yego
POSTGRES_PASSWORD=REMPLACEZ_MOI_mot_de_passe_db
POSTGRES_DB=yego
# Port exposé sur l'hôte pour l'API conteneurisée :
API_PORT=3000
# Port exposé sur l'hôte pour la base (5432 côté réseau Docker) :
DB_HOST_PORT=5434
# Jouer le seed au premier démarrage du conteneur :
SEED_ON_START=false
