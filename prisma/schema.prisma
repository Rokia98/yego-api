generator client {
  provider      = "prisma-client-js"
  // 'native' pour le poste de dev ; la cible musl/openssl-3 pour l'image
  // Docker (node:20-alpine) — évite tout téléchargement de moteur au runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ville {
  id             Int       @id @default(autoincrement())
  nom            String    @unique
  // Coordonnées du centre-ville, utilisées pour l'ETA du suivi GPS
  // (distance à vol d'oiseau × facteur route). Optionnelles.
  latitude       Float?
  longitude      Float?
  trajetsDepart  Trajet[]  @relation("VilleDepart")
  trajetsArrivee Trajet[]  @relation("VilleArrivee")

  @@map("villes")
}

model Compagnie {
  id            Int            @id @default(autoincrement())
  nom           String
  telephone     String?
  email         String?
  logoUrl       String?        @map("logo_url")
  statut        String         @default("en_attente")
  dateCreation  DateTime       @default(now()) @map("date_creation")
  // Coordonnées de reversement (Mobile Money) : où Yègo transfère, via Jèko,
  // les billets vendus en ligne. jekoContactId = contact bénéficiaire créé
  // chez Jèko pour ces coordonnées (remis à NULL quand elles changent).
  reversementMoyen     String?  @map("reversement_moyen")
  reversementTelephone String?  @map("reversement_telephone")
  jekoContactId        String?  @map("jeko_contact_id")

  abonnements   Abonnement[]
  reversements  Reversement[]
  vehicules     Vehicule[]
  chauffeurs    Chauffeur[]
  trajets       Trajet[]
  documents     CompagnieDocument[]
  demandesSupport DemandeSupport[]
  // Personnel rattaché à la compagnie : company_admin et agents guichet.
  utilisateurs  Utilisateur[]

  @@map("compagnies")
}

model Abonnement {
  id           Int       @id @default(autoincrement())
  compagnieId  Int       @map("compagnie_id")
  plan         String
  montant      Decimal   @db.Decimal(10, 2)
  dateDebut    DateTime  @map("date_debut")
  dateFin      DateTime  @map("date_fin")
  statut       String    @default("actif")

  compagnie    Compagnie @relation(fields: [compagnieId], references: [id], onDelete: Cascade)

  @@map("abonnements")
}

model Vehicule {
  id              Int       @id @default(autoincrement())
  compagnieId     Int       @map("compagnie_id")
  immatriculation String    @unique
  typeVehicule    String?   @map("type_vehicule")
  capacite        Int
  statut          String    @default("actif")

  compagnie       Compagnie @relation(fields: [compagnieId], references: [id], onDelete: Cascade)
  departs         Depart[]

  @@map("vehicules")
}

model Chauffeur {
  id            Int       @id @default(autoincrement())
  compagnieId   Int       @map("compagnie_id")
  nom           String
  telephone     String?
  numeroPermis  String?   @map("numero_permis")

  compagnie     Compagnie @relation(fields: [compagnieId], references: [id], onDelete: Cascade)
  departs       Depart[]

  @@map("chauffeurs")
}

model Trajet {
  id                   Int       @id @default(autoincrement())
  compagnieId          Int       @map("compagnie_id")
  villeDepartId        Int       @map("ville_depart_id")
  villeArriveeId       Int       @map("ville_arrivee_id")
  heureDepart          DateTime  @map("heure_depart") @db.Time()
  heureArriveeEstimee  DateTime? @map("heure_arrivee_estimee") @db.Time()
  prix                 Decimal   @db.Decimal(10, 2)
  joursRecurrence      String?   @map("jours_recurrence")
  statut               String    @default("actif")

  compagnie            Compagnie @relation(fields: [compagnieId], references: [id], onDelete: Cascade)
  villeDepart          Ville     @relation("VilleDepart", fields: [villeDepartId], references: [id])
  villeArrivee         Ville     @relation("VilleArrivee", fields: [villeArriveeId], references: [id])
  departs              Depart[]

  @@map("trajets")
}

model Depart {
  id                 Int           @id @default(autoincrement())
  trajetId           Int           @map("trajet_id")
  vehiculeId         Int?          @map("vehicule_id")
  chauffeurId        Int?          @map("chauffeur_id")
  dateDepart         DateTime      @map("date_depart") @db.Date
  placesTotales      Int           @map("places_totales")
  placesDisponibles  Int           @map("places_disponibles")
  // planifie -> en_route (parti, GPS actif) -> arrive ; annule à tout moment.
  statut             String        @default("planifie")
  demarreA           DateTime?     @map("demarre_a")
  termineA           DateTime?     @map("termine_a")
  // Retard estimé (minutes) sur l'heure d'arrivée prévue. 0 = à l'heure.
  retardMinutes      Int           @default(0) @map("retard_minutes")
  // Dernier palier de retard déjà notifié aux voyageurs (anti-spam du cron).
  retardNotifieMinutes Int         @default(0) @map("retard_notifie_minutes")

  trajet             Trajet           @relation(fields: [trajetId], references: [id], onDelete: Cascade)
  vehicule           Vehicule?        @relation(fields: [vehiculeId], references: [id])
  chauffeur          Chauffeur?       @relation(fields: [chauffeurId], references: [id])
  reservations       Reservation[]
  positions          PositionDepart[]

  @@unique([trajetId, dateDepart])
  @@index([dateDepart])
  @@map("departs")
}

// Point GPS envoyé périodiquement par le téléphone du chauffeur pendant un
// départ « en_route ». Purgé après le trajet (voir MaintenanceService).
model PositionDepart {
  id           Int      @id @default(autoincrement())
  departId     Int      @map("depart_id")
  latitude     Float
  longitude    Float
  vitesse      Float?   // km/h
  cap          Float?   // degrés (0 = nord)
  precision    Float?   // mètres (précision GPS annoncée)
  mesureA      DateTime @map("mesure_a")     // horodatage de l'appareil
  enregistreA  DateTime @default(now()) @map("enregistre_a") // réception serveur

  depart       Depart   @relation(fields: [departId], references: [id], onDelete: Cascade)

  @@index([departId, mesureA])
  @@map("positions_depart")
}

model Utilisateur {
  id               Int           @id @default(autoincrement())
  nom              String
  telephone        String        @unique
  email            String?
  // URL http(s) ou data-URI (image compressée côté client) — même contrat que
  // Compagnie.logoUrl (voir EstImageValide). Pas de stockage fichier côté API.
  photoUrl         String?       @map("photo_url")
  motDePasseHash   String?       @map("mot_de_passe_hash")
  // true pour un compte dont le mot de passe a été généré par un tiers (ex.
  // POST /compagnies/:id/compte-admin) : le client doit inviter au changement
  // via PATCH /auth/mot-de-passe, qui repasse ce flag à false. À ne pas
  // confondre avec le champ de réponse `motDePasseTemporaire` (le mot de passe
  // en clair, renvoyé une seule fois par POST /compagnies/:id/compte-admin).
  doitChangerMotDePasse Boolean  @default(false) @map("doit_changer_mot_de_passe")
  role             String        @default("user")
  // Compte actif ? Un compte désactivé ne peut plus se connecter et ses
  // access tokens en cours sont invalidés (voir tokenVersion / JwtStrategy).
  actif            Boolean       @default(true)
  // Rattachement à une compagnie pour les rôles 'agent' et 'company_admin' :
  // leurs actions sont limitées aux ressources de cette compagnie.
  compagnieId      Int?          @map("compagnie_id")
  // Incrémenté lors d'une déconnexion globale / changement de mot de passe :
  // invalide instantanément tous les access tokens déjà émis (voir JwtStrategy).
  tokenVersion     Int           @default(0) @map("token_version")
  dateCreation     DateTime      @default(now()) @map("date_creation")

  compagnie          Compagnie?     @relation(fields: [compagnieId], references: [id], onDelete: SetNull)
  reservations       Reservation[]  @relation("ReservationVoyageur")
  reservationsSaisies Reservation[] @relation("ReservationAgent")
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  appareils          AppareilNotification[]
  notifications      Notification[]
  demandesSupport    DemandeSupport[] @relation("DemandeSupportAuteur")
  messagesSupport    MessageSupport[] @relation("MessageSupportAuteur")

  @@index([email])
  @@index([compagnieId])
  @@map("utilisateurs")
}

// Jeton d'un appareil (FCM) pour recevoir les notifications push.
model AppareilNotification {
  id                  Int         @id @default(autoincrement())
  utilisateurId       Int         @map("utilisateur_id")
  token               String      @unique
  plateforme          String      // android | ios | web
  dateCreation        DateTime    @default(now()) @map("date_creation")
  derniereUtilisation DateTime    @default(now()) @map("derniere_utilisation")

  utilisateur         Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("appareils_notification")
}

// Notification destinée à un voyageur : persistée (fil in-app) + envoyée en push.
model Notification {
  id            Int         @id @default(autoincrement())
  utilisateurId Int         @map("utilisateur_id")
  type          String      // reservation.confirmee, paiement.confirme, depart.rappel...
  titre         String
  corps         String
  donnees       Json?       // payload de navigation (deep link)
  lu            Boolean     @default(false)
  dateCreation  DateTime    @default(now()) @map("date_creation")

  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId, lu])
  @@map("notifications")
}

model RefreshToken {
  id             Int          @id @default(autoincrement())
  utilisateurId  Int          @map("utilisateur_id")
  // On ne stocke jamais le jeton en clair : seulement son SHA-256.
  tokenHash      String       @unique @map("token_hash")
  expiresAt      DateTime     @map("expires_at")
  revokedAt      DateTime?    @map("revoked_at")
  // Rotation : id du jeton qui a remplacé celui-ci lors d'un /auth/refresh.
  remplacePar    Int?         @map("remplace_par")
  creeParIp      String?      @map("cree_par_ip")
  userAgent      String?      @map("user_agent")
  dateCreation   DateTime     @default(now()) @map("date_creation")

  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([utilisateurId])
  @@map("refresh_tokens")
}

model AuditLog {
  id            Int          @id @default(autoincrement())
  acteurId      Int?         @map("acteur_id")
  acteurRole    String?      @map("acteur_role")
  action        String
  entite        String
  entiteId      Int?         @map("entite_id")
  metadata      Json?
  ip            String?
  dateCreation  DateTime     @default(now()) @map("date_creation")

  acteur        Utilisateur? @relation(fields: [acteurId], references: [id], onDelete: SetNull)

  @@index([entite, entiteId])
  @@index([action])
  @@index([acteurId])
  @@map("audit_logs")
}

model Reservation {
  id                Int           @id @default(autoincrement())
  // Le voyageur connecté (canal 'en_ligne'). NULL pour une vente au guichet :
  // le voyageur n'a pas de compte, seuls son nom et son téléphone sont notés.
  utilisateurId     Int?          @map("utilisateur_id")
  // L'agent qui a saisi la réservation, uniquement pour le canal 'guichet'.
  agentId           Int?          @map("agent_id")
  // Identité du voyageur au guichet (quand utilisateurId est NULL).
  passagerNom       String?       @map("passager_nom")
  passagerTelephone String?       @map("passager_telephone")
  departId          Int           @map("depart_id")
  nombrePlaces      Int           @map("nombre_places")
  // Sièges choisis par le voyageur AVANT le paiement (un par place). Vide si
  // placement libre. Réutilisés tels quels à la génération des tickets.
  sieges            String[]      @default([])
  canal             String
  statut            String        @default("confirmee")
  dateReservation   DateTime      @default(now()) @map("date_reservation")

  utilisateur       Utilisateur?  @relation("ReservationVoyageur", fields: [utilisateurId], references: [id])
  agent             Utilisateur?  @relation("ReservationAgent", fields: [agentId], references: [id])
  depart            Depart        @relation(fields: [departId], references: [id])
  tickets           Ticket[]
  paiement          Paiement?
  remboursement     Remboursement?
  demandesSupport   DemandeSupport[]

  @@index([utilisateurId])
  @@index([agentId])
  @@index([departId])
  @@map("reservations")
}

model Ticket {
  id             Int         @id @default(autoincrement())
  reservationId  Int         @map("reservation_id")
  codeQr         String      @unique @map("code_qr")
  siege          String?
  statut         String      @default("valide")
  dateCreation   DateTime    @default(now()) @map("date_creation")

  reservation    Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model Paiement {
  id                     Int         @id @default(autoincrement())
  reservationId          Int         @unique @map("reservation_id")
  // Prix des billets (part de la compagnie : base des remboursements et des
  // reversements).
  montant                Decimal     @db.Decimal(10, 2)
  // Frais de service Yègo payés en plus par le voyageur sur un achat en ligne
  // (FRAIS_SERVICE_POURCENT). Ni remboursés ni reversés. 0 au guichet.
  fraisService           Decimal     @default(0) @map("frais_service") @db.Decimal(10, 2)
  moyenPaiement          String      @map("moyen_paiement")
  referenceTransaction   String?     @map("reference_transaction")
  statut                 String      @default("en_attente")
  datePaiement           DateTime?   @map("date_paiement")
  // Paiement en ligne via Jèko : une demande de paiement par tentative, de
  // référence YEGO-P<id>-T<n> (Jèko refuse de réutiliser une référence).
  jekoPaymentRequestId   String?     @unique @map("jeko_payment_request_id")
  jekoReference          String?     @map("jeko_reference")
  jekoTentatives         Int         @default(0) @map("jeko_tentatives")
  jekoDemandeLe          DateTime?   @map("jeko_demande_le")
  // URL à ouvrir côté app (opérateur Orange/Wave/Djamo, ou page d'attente
  // Jèko pour MTN/Moov qui confirment par USSD).
  urlPaiement            String?     @map("url_paiement")
  // Numéro qui a payé : destination d'un éventuel remboursement.
  telephonePayeur        String?     @map("telephone_payeur")
  // Reversement à la compagnie qui a soldé ce paiement (NULL = pas encore reversé).
  reversementId          Int?        @map("reversement_id")

  reservation            Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  reversement            Reversement? @relation(fields: [reversementId], references: [id], onDelete: SetNull)

  @@index([reversementId])
  @@map("paiements")
}

model Remboursement {
  id                  Int         @id @default(autoincrement())
  reservationId       Int         @unique @map("reservation_id")
  montantRembourse    Decimal     @map("montant_rembourse") @db.Decimal(10, 2)
  fraisRetenus        Decimal     @default(0) @map("frais_retenus") @db.Decimal(10, 2)
  statut              String      @default("en_attente")
  dateDemande         DateTime    @default(now()) @map("date_demande")
  dateRemboursement   DateTime?   @map("date_remboursement")
  // Remboursement par transfert Jèko vers le numéro qui a payé :
  // en_attente → en_cours (transfert initié) → rembourse | echoue.
  jekoTransferId      String?     @unique @map("jeko_transfer_id")
  jekoReference       String?     @map("jeko_reference")
  jekoTentatives      Int         @default(0) @map("jeko_tentatives")
  motifEchec          String?     @map("motif_echec")

  reservation         Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("remboursements")
}

// Reversement à une compagnie, par transfert Jèko, des billets payés en ligne
// (encaissés sur le magasin Jèko de Yègo). Solde un lot de paiements :
// en_cours → effectue | echoue (les paiements sont alors libérés).
model Reversement {
  id              Int        @id @default(autoincrement())
  compagnieId     Int        @map("compagnie_id")
  montantBrut     Decimal    @map("montant_brut") @db.Decimal(12, 2)
  commission      Decimal    @default(0) @db.Decimal(12, 2)
  montantNet      Decimal    @map("montant_net") @db.Decimal(12, 2)
  nombrePaiements Int        @map("nombre_paiements")
  moyen           String
  beneficiaire    String
  statut          String     @default("en_cours")
  jekoTransferId  String?    @unique @map("jeko_transfer_id")
  jekoReference   String?    @unique @map("jeko_reference")
  fraisJeko       Decimal?   @map("frais_jeko") @db.Decimal(12, 2)
  motifEchec      String?    @map("motif_echec")
  creeParId       Int?       @map("cree_par_id")
  dateCreation    DateTime   @default(now()) @map("date_creation")
  dateEffectue    DateTime?  @map("date_effectue")

  compagnie       Compagnie  @relation(fields: [compagnieId], references: [id], onDelete: Restrict)
  paiements       Paiement[]

  @@index([compagnieId])
  @@map("reversements")
}

// Demande d'assistance (support) : ouverte par un voyageur (app mobile) ou le
// personnel d'une compagnie (dashboard). Traitée par l'équipe Yègo (admin) ;
// le company_admin traite aussi les demandes voyageurs de sa compagnie.
// compagnieId est toujours dérivé côté serveur (jamais pris du client).
model DemandeSupport {
  id              Int       @id @default(autoincrement())
  auteurId        Int       @map("auteur_id")
  auteurRole      String    @map("auteur_role")
  compagnieId     Int?      @map("compagnie_id")
  reservationId   Int?      @map("reservation_id")
  // reservation | paiement | remboursement | ticket | compte | abonnement | technique | autre
  categorie       String
  sujet           String
  // ouverte | en_cours | resolue | fermee
  statut          String    @default("ouverte")
  // normale | haute
  priorite        String    @default("normale")
  dateCreation    DateTime  @default(now()) @map("date_creation")
  dateMaj         DateTime  @updatedAt @map("date_maj")
  dernierMessageA DateTime  @default(now()) @map("dernier_message_a")
  nbMessages      Int       @default(0) @map("nb_messages")

  auteur          Utilisateur      @relation("DemandeSupportAuteur", fields: [auteurId], references: [id], onDelete: Cascade)
  compagnie       Compagnie?       @relation(fields: [compagnieId], references: [id], onDelete: SetNull)
  reservation     Reservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  messages        MessageSupport[]

  @@index([auteurId])
  @@index([compagnieId])
  @@index([statut])
  @@index([dernierMessageA])
  @@map("demandes_support")
}

model MessageSupport {
  id           Int       @id @default(autoincrement())
  demandeId    Int       @map("demande_id")
  // NULL si le compte auteur a été supprimé (le fil reste lisible).
  auteurId     Int?      @map("auteur_id")
  auteurRole   String    @map("auteur_role")
  contenu      String
  // Note interne de l'équipe Yègo : visible par l'admin uniquement.
  interne      Boolean   @default(false)
  dateCreation DateTime  @default(now()) @map("date_creation")

  demande      DemandeSupport @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  auteur       Utilisateur?   @relation("MessageSupportAuteur", fields: [auteurId], references: [id], onDelete: SetNull)

  @@index([demandeId, dateCreation])
  @@map("messages_support")
}

// Pièce d'inscription d'une compagnie (registre de commerce, autorisation de
// transport, pièce d'identité du gérant…), à valider par l'admin plateforme.
// Fichier stocké sur disque (volume Docker) ; seul le chemin est en base,
// jamais exposé tel quel au client (voir DocumentsService).
model CompagnieDocument {
  id               Int       @id @default(autoincrement())
  compagnieId      Int       @map("compagnie_id")
  type             String
  nomFichier       String    @map("nom_fichier")
  cheminFichier    String    @map("chemin_fichier")
  tailleOctets     Int       @map("taille_octets")
  mimeType         String    @map("mime_type")
  statut           String    @default("en_attente")
  commentaireAdmin String?   @map("commentaire_admin")
  dateUpload       DateTime  @default(now()) @map("date_upload")
  dateRevue        DateTime? @map("date_revue")

  compagnie        Compagnie @relation(fields: [compagnieId], references: [id], onDelete: Cascade)

  @@index([compagnieId])
  @@map("compagnie_documents")
}
